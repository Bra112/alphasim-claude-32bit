{
  "name": "alphasim",
  "version": "0.1.0",
  "description": "AlphaSim - offline forex tick-data backtesting simulator",
  "author": "AlphaSim",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "adm-zip": "0.5.16",
    "electron-updater": "6.3.9",
    "lightweight-charts": "4.2.1"
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.alphasim.app",
    "productName": "AlphaSim",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "files": [
      "main.js",
      "preload.js",
      "downloader.js",
      "license.js",
      "renderer/**/*",
      "build/icon.png",
      "lzma.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github"
      }
    ]
  }
}